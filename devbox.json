{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "env": {
    "DEVBOX_NO_PROMPT": "1"
  },
  "shell": {
    "init_hook": ["export name=\"$(basename $(pwd))\"", "uv sync"],
    "scripts": {
      "start": "uv run python3 generate.py",
      "tests": "uv run pytest",
      "uv-sync": "uv sync"
    }
  }
}
